{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fullme",
  "version": "0.1.0",
  "identifier": "com.fullme.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "fullme",
        "width": 320,
        "height": 160,
        "focus": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
